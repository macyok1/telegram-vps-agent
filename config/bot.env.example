# Только собственные доступы. Реальный файл: /etc/litellm-telegram-bot.env (0600).
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_ADMIN_ID=REPLACE_WITH_YOUR_NUMERIC_USER_ID
LITELLM_INTERNAL_URL=http://127.0.0.1:4000
LITELLM_CHAT_KEY=REPLACE_WITH_YOUR_GATEWAY_CHAT_KEY
LITELLM_MASTER_KEY=REPLACE_WITH_YOUR_GATEWAY_MASTER_KEY
LITELLM_BOT_MODEL=bot-model
LITELLM_FALLBACK_MODELS=
BOT_REQUEST_TIMEOUT=180
BOT_LOG_LEVEL=INFO
BOT_SUPERMEMORY_RECALL=0
VAULT_PATH=/var/lib/litellm-telegram-bot/vault.json
ALLOWED_PATH=/var/lib/litellm-telegram-bot/allowed.json
ALLOWED_USERS=
ALLOWED_GROUPS=
